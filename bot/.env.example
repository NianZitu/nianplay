# ─── NianPlay Bot — configuração ───────────────────────────────────────────────
# Copie este arquivo para ".env" e preencha. Nunca publique o .env (ele tem o token do bot).

# Discord Developer Portal → sua aplicação → Bot → "Reset Token"
DISCORD_TOKEN=
# Discord Developer Portal → sua aplicação → General Information → "Application ID"
DISCORD_CLIENT_ID=
# Opcional: ID de um servidor para os comandos aparecerem na hora (bom para testar).
# Deixe vazio para registrar em todos os servidores (pode levar até 1 hora para aparecer).
DISCORD_GUILD_ID=

# ─── YouTube ───────────────────────────────────────────────────────────────────
# Caminhos (o install.sh já instala os dois; só mude se estiverem em outro lugar)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# O YouTube costuma bloquear servidores ("Sign in to confirm you're not a bot").
# Se acontecer, exporte um cookies.txt de uma conta do YouTube (de preferência uma conta
# secundária) e informe o caminho aqui. Veja o README.
YTDLP_COOKIES=
# Argumentos extras para o yt-dlp (avançado)
YTDLP_EXTRA_ARGS=

# ─── Spotify (opcional) ────────────────────────────────────────────────────────
# Sem isso, playlists/álbuns do Spotify são lidos pela página pública (até ~100 faixas).
# Com um app gratuito em developer.spotify.com não há limite.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Comportamento ─────────────────────────────────────────────────────────────
DEFAULT_VOLUME=70
MAX_QUEUE=1000
# Sai do canal X segundos depois que a fila acaba / quando fica sozinho
IDLE_LEAVE_SECONDS=180
ALONE_LEAVE_SECONDS=120
# Aplica o ganho da equalização (LUFS) e os cortes de trecho salvos no NianPlay
APPLY_NIANPLAY_GAIN=true
APPLY_NIANPLAY_CUTS=true
